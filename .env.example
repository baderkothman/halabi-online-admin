# Base URL of the Halabi Online NestJS API, without a trailing slash and
# WITHOUT the /api/v1 prefix — the API client appends that itself.
#
# This is the local development URL. Production builds use .env.production.
# The API defaults to port 4000 (see halabi-online-api/README.md).
VITE_API_BASE_URL=http://127.0.0.1:4000
